# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# TAURI UPDATER MINISIGN KEYS
# Required for signing Tauri desktop releases and verifying auto-updates.
# Generate using: npx @tauri-apps/cli signer generate -w ~/.tauri/tellyx.key
# ==============================================================================

# Public Minisign Key string (Injected into src-tauri/tauri.conf.json at build time)
TAURI_SIGNING_PUBLIC_KEY="dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQzBENDIxNjlENDM3RTYKUlVSRjlxY2RNSDljTGdUSlAxb25LTVM4dHhpUms4NnpkTGdrTmNzeW9ZOHlBVTFpM05LSE1xTEkK"

# Private Minisign Key string (Used by Tauri CLI / GitHub Actions to sign bundles)
TAURI_SIGNING_PRIVATE_KEY="dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHNlY3JldCBrZXkK..."

# Password for the private key (Leave blank if key has no password)
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# ==============================================================================
# ANDROID RELEASE KEYSTORE & GRADLE SIGNING
# Required for signing Android release APKs / AABs.
# ==============================================================================

# Base64-encoded string of the release.keystore file
# Linux/macOS: base64 -w 0 release.keystore
# Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("release.keystore"))
ANDROID_KEYSTORE_BASE64=""

# Password for the keystore file
ANDROID_KEYSTORE_PASSWORD="tellyxkey"

# Alias name inside the keystore
ANDROID_KEY_ALIAS="tellyxkey"

# Password for the key alias
ANDROID_KEY_PASSWORD="tellyxkey"
